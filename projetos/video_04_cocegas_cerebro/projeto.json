  "legenda": "impacto",
  "fontes": [
    "Blakemore, Wolpert & Frith (1998/1999/2000) — atenuação sensorial de toque autogerado; previsão a partir de cópia do comando motor; participação do cerebelo; atraso entre movimento e toque aumenta a sensação (sem números neste vídeo)."
  ],
  "destaques": [
    "cócegas",
    "pele",
