  "falas": [
    {
      "id": "w01",
      "bloco": "b1",
      "texto": "Chamam Logan de imortal.",
      "pausa": 1.0,
      "tts_personagem": "Chamam Lôgan de imortal."
    },
    {
      "id": "w02",
      "bloco": "b1",
      "texto": "Só que o Wolverine já morreu de verdade.",
      "pausa": 2.48
    },
    {
      "id": "w03",
      "bloco": "b1",
      "texto": "Antes de chegar lá, olha bem pra essas garras.",
      "pausa": 0.6
    },
    {
      "id": "w04",
      "bloco": "b1",
      "texto": "Elas já existiam muito antes do metal.",
      "pausa": 3.705
    },
    {
      "id": "w05",
      "bloco": "b2",
      "texto": "Em 1888, o Brasil aboliu legalmente a escravidão.",
      "pausa": 1.243,
      "tts_personagem": "Em mil oitocentos e oitenta e oito, o Brasil aboliu legalmente a escravidão."
    },
    {
      "id": "w06",
      "bloco": "b2",
      "texto": "Naquele fim de século, a Marvel situa a infância de James Howlett, um garoto frágil de Alberta, no Canadá.",
      "pausa": 1.243
    },
    {
      "id": "w07",
      "bloco": "b2",
      "texto": "Uma tragédia em casa despertou a mutação.",
      "pausa": 1.243
    },
    {
      "id": "w08",
      "bloco": "b2",
      "texto": "As garras que saíram das mãos dele eram de osso.",
      "pausa": 1.243
    },
    {
      "id": "w09",
      "bloco": "b2",
      "texto": "James fugiu e passou a se chamar Logan.",
      "pausa": 1.243
    },
    {
      "id": "w10",
      "bloco": "b2",
      "texto": "Seu fator de cura também desacelerou seu envelhecimento.",
      "pausa": 1.243
    },
    {
      "id": "w11",
      "bloco": "b3",
      "texto": "Em 1941, com Hitler no poder na Alemanha, Logan estava em Madripoor, uma ilha fictícia da Marvel.",
      "pausa": 1.686,
      "tts_personagem": "Em mil novecentos e quarenta e um, com Hitler no poder na Alemanha, Logan estava em Madripoor, uma ilha fictícia da Marvel."
    },
    {
      "id": "w12",
      "bloco": "b3",
      "texto": "Lá, ele encontrou Steve Rogers, o Capitão América.",
      "pausa": 1.686
    },
    {
      "id": "w13",
      "bloco": "b3",
      "texto": "Juntos, ajudaram a resgatar a jovem Natasha Romanoff.",
      "pausa": 1.686,
      "semente": 12190510,
      "tts_personagem": "Juntos, ajudaram a resgatar a jovem Natácha Romanóf."
    },
    {
      "id": "w14",
      "bloco": "b3",
      "texto": "Era a futura Viúva Negra.",
      "pausa": 1.686
    },
    {
      "id": "w15",
      "bloco": "b4",
      "texto": "O programa Arma X cobriu o esqueleto de Logan com adamantium.",
      "pausa": 1.8
    },
    {
      "id": "w16",
      "bloco": "b4",
      "texto": "O experimento deixou as garras mais resistentes e bagunçou a memória dele.",
      "pausa": 1.8
    },
    {
      "id": "w17",
      "bloco": "b4",
      "texto": "Anos depois, Magneto arrancou o metal do corpo do Wolverine.",
      "pausa": 1.8
    },
    {
      "id": "w18",
      "bloco": "b4",
      "texto": "Logan quase morreu.",
      "pausa": 1.8
    },
    {
      "id": "w19",
      "bloco": "b4",
      "texto": "Mesmo sem o adamantium, ainda conseguiu estender as garras de osso.",
      "pausa": 2.5
    },
    {
      "id": "w20",
      "bloco": "b5",
      "texto": "Logan chegou aos quadrinhos encarando o Hulk.",
      "pausa": 1.8,
      "semente": 12190409
    },
    {
      "id": "w21",
      "bloco": "b5",
      "texto": "Depois, entrou pros X-Men.",
      "pausa": 1.8,
      "semente": 12190409
    },
    {
      "id": "w22",
      "bloco": "b5",
      "texto": "Quando uma fuga em massa na prisão da Balsa deu origem aos Novos Vingadores, Wolverine entrou nessa formação.",
      "pausa": 1.8
    },
    {
      "id": "w23",
      "bloco": "b5",
      "texto": "Aquele menino de Alberta agora lutava ao lado do Capitão América, do Homem de Ferro e do Homem-Aranha.",
      "pausa": 2.5
    },
    {
      "id": "w24",
      "bloco": "b6",
      "texto": "Em A Morte de Wolverine, Logan já tinha perdido o fator de cura.",
      "pausa": 1.8
    },
    {
      "id": "w25",
      "bloco": "b6",
      "texto": "Ao tentar salvar pessoas de um experimento, ficou coberto de adamantium líquido.",
      "pausa": 1.8
    },
    {
      "id": "w26",
      "bloco": "b6",
      "texto": "O metal endureceu.",
      "pausa": 1.8
    },
    {
      "id": "w27",
      "bloco": "b6",
      "texto": "E ele morreu.",
      "pausa": 1.8
    },
    {
      "id": "w28",
      "bloco": "b6",
      "texto": "A Marvel só contou como ele voltou anos depois, em O Retorno de Wolverine.",
      "pausa": 2.5
    },
    {
      "id": "w29",
      "bloco": "b7",
      "texto": "Agora imagina uma cena inédita em 2026.",
      "pausa": 1.412,
      "tts_personagem": "Agora imagina uma cena inédita em dois mil e vinte e seis."
    },
    {
      "id": "w30",
      "bloco": "b7",
      "texto": "São Paulo.",
      "pausa": 1.412
    },
    {
      "id": "w31",
      "bloco": "b7",
      "texto": "Tem celular filmando de todo lado.",
      "pausa": 1.412,
      "semente": 12190510
    },
    {
      "id": "w32",
      "bloco": "b7",
      "texto": "No beco da abertura, um drone bloqueia a saída de um entregador.",
      "pausa": 1.412
    },
    {
      "id": "w33",
      "bloco": "b7",
      "texto": "Dessa vez, olha pra onde Logan pula.",
      "pausa": 1.412
    },
    {
      "id": "w34",
      "bloco": "b7",
      "texto": "As garras passam pela câmera e partem o drone.",
      "pausa": 1.412
    },
    {
      "id": "w35",
      "bloco": "b7",
      "texto": "Com a mão livre, ele puxa o rapaz antes da grade ceder.",
      "pausa": 1.412
    },
    {
      "id": "w36",
      "bloco": "b7",
      "texto": "O celular cai.",
      "pausa": 1.412
    },
    {
      "id": "w37",
      "bloco": "b7",
      "texto": "A gravação corta.",
      "pausa": 1.412
    },
    {
      "id": "w38",
      "bloco": "b7",
      "texto": "Mais de um século depois, Logan ainda escolhe a mesma coisa.",
      "pausa": 1.412
    },
    {
      "id": "w39",
      "bloco": "b7",
      "texto": "Quando alguém tá em perigo, ele vai pra cima.",
      "pausa": 0.35
    }
  ],
